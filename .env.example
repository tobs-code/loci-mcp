# Docker Compose credentials (REQUIRED).
# Generate values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_USER=memory
POSTGRES_DB=memory
POSTGRES_PASSWORD=
# Bearer token for the MCP HTTP transport. Every request must send
#   Authorization: Bearer <MCP_AUTH_TOKEN>
# The server refuses to start on a non-loopback bind without it.
MCP_AUTH_TOKEN=
# Never enable this outside a trusted sandbox: it disables the token check.
MCP_ALLOW_INSECURE_HTTP=false

# LLM used for contradiction detection (/nli).
# groq | openai | anthropic | ollama | openai-compatible | auto | none
# "auto" picks the first configured key (Groq, OpenAI, Anthropic).
#
# DATA EGRESS: groq, openai and anthropic are hosted services. When
# `check_contradictions` or `contradictions_report` runs, the compared memory
# content is sent to that provider. Use ollama/openai-compatible with a local
# endpoint (or LLM_PROVIDER=none) to keep memory content on this machine.
LLM_PROVIDER=groq

# Optional overrides. Leave empty to use the provider defaults.
# Defaults: groq=openai/gpt-oss-20b, openai=gpt-4o-mini,
# anthropic=claude-3-5-haiku-latest, ollama=llama3.2
LLM_MODEL=
# low/medium/high; empty defaults to low for Groq/gpt-oss, none otherwise
LLM_REASONING_EFFORT=
LLM_API_KEY=
# Full OpenAI-compatible base URL, e.g. http://localhost:11434/v1
LLM_BASE_URL=

# Groq (default provider)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Ollama (OpenAI-compatible endpoint; /v1 is added automatically)
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Contradiction scan limits (agent MCP calls must not outlive the transport
# timeout): the NLI leg stops at the budget and reports unchecked pairs in
# `nli_failures` instead of timing out.
# CONTRADICTION_SCAN_BUDGET_SECONDS=40
# CONTRADICTION_NEIGHBORS=6
# CONTRADICTION_NLI_WORKERS=6

# Inference device: auto (CUDA when available, else CPU), cpu, or cuda.
# GPU use also needs the GPU compose override:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# Build a smaller CPU-only image with:
#   TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
INFERENCE_DEVICE=auto
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126

# Local cross-encoder reranking (no API key). The model is downloaded into the
# inference image and applied only when the first-stage ranking is ambiguous.
# RERANK_ENABLED=true
# RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# RERANK_MAX_LENGTH=256
# RERANK_TOP_K=10
# RERANK_TRIGGER_SCORE=0.85
# RERANK_TRIGGER_MARGIN=0.10
# RERANK_ALWAYS=false
# RERANK_LOGIT_BIAS=1.0
